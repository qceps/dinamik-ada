<Window x:Class="DynamicIsland.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland.App.Island"
        Title="Dinamik Ada"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        Width="432" Height="208"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="TertiaryText" Color="#73FFFFFF" />

        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ScaleRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid x:Name="Stage" Width="432" Height="208">
            <!-- Yalnızca gölge: adanın arkasında aynı boyutta duran plaka -->
            <Border x:Name="ShadowPlate"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="{Binding ActualWidth, ElementName=Island}"
                    Height="{Binding ActualHeight, ElementName=Island}"
                    Background="Black" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect x:Name="Shadow" BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Opacity="0.38" Color="Black" RenderingBias="Performance" />
                </Border.Effect>
            </Border>

            <Border x:Name="Island"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="172" Height="34"
                    Background="Black">
                <Grid x:Name="LayerHost">

                    <!-- BEKLEME: Spotify kapalı / oturum yok / müzik yok -->
                    <Grid x:Name="IdleLayer" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="11" Height="12" Stretch="Uniform" Fill="{StaticResource TertiaryText}" VerticalAlignment="Center"
                                  Data="M9,1 L19,0 L19,13.2 A3.2,3.2 0 1 1 17,10.3 L17,4.2 L11,4.9 L11,15.2 A3.2,3.2 0 1 1 9,12.3 Z" />
                            <TextBlock x:Name="IdleText" Margin="7,0,0,1" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Text="Spotify kapalı" />
                        </StackPanel>
                    </Grid>

                    <!-- KÜÇÜK: kapak + gösterge -->
                    <Grid x:Name="CompactLayer" Width="172" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
                        <local:ArtworkView x:Name="CompactArt" Width="24" Height="24" Radius="7"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0" />
                        <local:PlaybackBars x:Name="CompactBars" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,13,0" BarHeight="13" BarWidth="2.6" />
                    </Grid>

                    <!-- ŞARKI DEĞİŞİMİ: kapak + başlık + sanatçı -->
                    <Grid x:Name="PeekLayer" Width="330" Height="54" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
                        <local:ArtworkView x:Name="PeekArt" Width="40" Height="40" Radius="10"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0" />
                        <StackPanel Margin="58,0,50,1" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="PeekArtist" FontSize="12" Margin="0,1,0,0" Foreground="{StaticResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <local:PlaybackBars x:Name="PeekBars" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,18,0" BarHeight="15" BarWidth="3" />
                    </Grid>

                    <!-- GENİŞ: büyük kapak, bilgiler, ilerleme, kontroller -->
                    <Grid x:Name="ExpandedLayer" Width="376" Height="176" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
                        <local:ArtworkView x:Name="ExpandedArt" Width="66" Height="66" Radius="14"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,18,0,0" />

                        <StackPanel Margin="98,21,52,0" VerticalAlignment="Top">
                            <TextBlock x:Name="ExpandedTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="ExpandedArtist" FontSize="13" Margin="0,2,0,0" Foreground="{StaticResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="ExpandedAlbum" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource TertiaryText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,20,0">
                            <local:PlaybackBars x:Name="ExpandedBars" HorizontalAlignment="Right" BarHeight="16" BarWidth="3" />
                            <Border x:Name="DemoBadge" Visibility="Collapsed" Margin="0,8,0,0" Padding="5,1" CornerRadius="4"
                                    Background="#26FFFFFF" HorizontalAlignment="Right">
                                <TextBlock Text="DEMO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" />
                            </Border>
                        </StackPanel>

                        <!-- İlerleme (yalnızca oturum zaman çizelgesi bildiriyorsa) -->
                        <Grid x:Name="ProgressRow" VerticalAlignment="Top" Margin="18,98,18,0" Height="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Grid.Column="0" FontSize="11" Foreground="{StaticResource TertiaryText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Text="0:00" />
                            <Grid x:Name="SeekArea" Grid.Column="1" Background="Transparent" Margin="4,0">
                                <Border x:Name="TrackBar" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                                <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="#E6FFFFFF"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" />
                                <Ellipse x:Name="SeekThumb" Width="10" Height="10" Fill="White" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="SeekThumbOffset" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11" Foreground="{StaticResource TertiaryText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00" />
                        </Grid>

                        <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0">
                            <Button x:Name="PreviousButton" Style="{StaticResource IslandButton}" Width="42" Height="42" ToolTip="Önceki">
                                <Path Width="16" Height="15" Stretch="Uniform" Fill="White" Data="M1,1 H3.4 V15 H1 Z M15,1.4 V14.6 L4.8,8 Z" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}" Width="50" Height="50" Margin="20,-4,20,0" ToolTip="Oynat / Duraklat">
                                <Grid>
                                    <Path x:Name="PlayIcon" Width="20" Height="22" Stretch="Uniform" Fill="White" Margin="3,0,0,0"
                                          StrokeLineJoin="Round" Stroke="White" StrokeThickness="1.6" Data="M3,1 L15,8 L3,15 Z" />
                                    <Path x:Name="PauseIcon" Width="18" Height="21" Stretch="Uniform" Fill="White" Visibility="Collapsed"
                                          Data="M2,0.5 H6.5 V15.5 H2 Z M9.5,0.5 H14 V15.5 H9.5 Z" />
                                </Grid>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource IslandButton}" Width="42" Height="42" ToolTip="Sonraki">
                                <Path Width="16" Height="15" Stretch="Uniform" Fill="White" Data="M15,1 H12.6 V15 H15 Z M1,1.4 V14.6 L11.2,8 Z" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Etkileşim modu göstergesi: ince halka -->
            <Border x:Name="InteractionRing" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="{Binding ActualWidth, ElementName=Island}" Height="{Binding ActualHeight, ElementName=Island}"
                    BorderBrush="#66FFFFFF" BorderThickness="1.5" IsHitTestVisible="False" Opacity="0" />
        </Grid>
    </Grid>
</Window>
