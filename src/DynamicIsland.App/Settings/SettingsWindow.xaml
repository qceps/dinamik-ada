<Window x:Class="DynamicIsland.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland.App.Settings"
        ThemeMode="System"
        Title="Dinamik Ada — Ayarlar"
        Width="540" Height="760" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,16">
                <TextBlock Text="Dinamik Ada" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,2,0,0" />

                <!-- GENEL -->
                <TextBlock Text="Genel" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsBox" Content="Windows ile başlat" Margin="0,4" />
                        <CheckBox x:Name="HoverBox" Content="Fareyle üzerine gelince genişlet" Margin="0,4" />
                        <CheckBox x:Name="MediaHudBox" Content="Ses ve oynat/duraklat değişince adada kısa gösterge (medya tuşları)" Margin="0,4" />
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Spotify kapalıyken / müzik yokken" Style="{StaticResource RowLabel}" TextWrapping="Wrap" />
                            <ComboBox x:Name="IdleBox" Grid.Column="1" MinWidth="200">
                                <ComboBoxItem Content="Küçük bekleme kapsülü göster" />
                                <ComboBoxItem Content="Adayı gizle" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ŞARKI SÖZLERİ -->
                <TextBlock Text="Şarkı sözleri" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="LyricsBox" Content="Zamanlanmış şarkı sözlerini göster" Margin="0,4" />
                        <CheckBox x:Name="LyricsCompactBox" Content="Küçük adada çalan satırı göster (söz yoksa şarkı adı ve sanatçı)" Margin="0,4" />
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Söz yazı tipi" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="LyricsFontBox" Grid.Column="1" MinWidth="220">
                                <ComboBoxItem Content="Inter (iPhone tarzı kalın)" FontFamily="/Assets/Fonts/#Inter Display" FontWeight="Bold" />
                                <ComboBoxItem Content="Segoe UI Variable (kalın)" FontFamily="Segoe UI Variable Display" FontWeight="Bold" />
                                <ComboBoxItem Content="Segoe UI Black (çok kalın)" FontFamily="Segoe UI" FontWeight="Black" />
                                <ComboBoxItem Content="Bahnschrift (dar, modern)" FontFamily="Bahnschrift" FontWeight="SemiBold" />
                                <ComboBoxItem Content="Franklin Gothic" FontFamily="Franklin Gothic" FontWeight="Medium" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Sözler LRCLIB (lrclib.net) adlı ücretsiz hizmetten alınır: bunun için çalan parçanın adı, sanatçısı, albümü ve süresi bu hizmete gönderilir. Sözler yalnızca bellekte tutulur, diske veya günlüğe yazılmaz. Her parçanın zamanlanmış sözü bulunmayabilir." />
                    </StackPanel>
                </Border>

                <!-- TEMA -->
                <TextBlock Text="Tema" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ada rengi" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="260">
                                <ComboBoxItem Content="Siyah + kapak rengi (varsayılan)" />
                                <ComboBoxItem Content="Tam siyah" />
                                <ComboBoxItem Content="Şarkıya göre renkli" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Tam siyah: ışıma yok, çalma göstergesi beyaz. Şarkıya göre: adanın arka planı çalan şarkının kapağından alınan koyu bir renge boyanır ve şarkı değişince yumuşakça geçer. Arka plan opaklığı aşağıdan ayarlanır." />
                    </StackPanel>
                </Border>

                <!-- KONUM VE GÖRÜNÜM -->
                <TextBlock Text="Konum ve görünüm" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitör" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="MonitorBox" Grid.Column="1" MinWidth="260" />
                        </Grid>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="OffsetValue" DockPanel.Dock="Right" Opacity="0.75" />
                            <TextBlock Text="Yatay konum" />
                        </DockPanel>
                        <Slider x:Name="OffsetSlider" Minimum="-700" Maximum="700" SmallChange="5" LargeChange="50" />

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="TopValue" DockPanel.Dock="Right" Opacity="0.75" />
                            <TextBlock Text="Üst kenar mesafesi" />
                        </DockPanel>
                        <Slider x:Name="TopSlider" Minimum="0" Maximum="80" SmallChange="1" LargeChange="5" />

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Opacity="0.75" />
                            <TextBlock Text="Boyut" />
                        </DockPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.4" SmallChange="0.05" LargeChange="0.1" />

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Opacity="0.75" />
                            <TextBlock Text="Arka plan opaklığı" />
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" SmallChange="0.05" LargeChange="0.1" />

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Bu pencere açıkken adayı fareyle tutup sürükleyerek de taşıyabilirsiniz (ortaya yaklaşınca ortaya yapışır). Pencere kapanınca ada kilitlenir." />
                        <Button x:Name="ResetPositionButton" Content="Konumu varsayılana döndür" HorizontalAlignment="Left" Margin="0,6,0,4" />
                    </StackPanel>
                </Border>

                <!-- ANİMASYON -->
                <TextBlock Text="Animasyon" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AnimationsBox" Content="Animasyonlar" Margin="0,4" />
                        <TextBlock x:Name="ReducedMotionNote" Style="{StaticResource Hint}" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="PeekValue" DockPanel.Dock="Right" Opacity="0.75" />
                            <TextBlock Text="Şarkı değişiminde açık kalma süresi" />
                        </DockPanel>
                        <Slider x:Name="PeekSlider" Minimum="1" Maximum="10" SmallChange="0.5" LargeChange="1" />
                    </StackPanel>
                </Border>

                <!-- OYUN MODU -->
                <TextBlock Text="Oyun modu" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Oyun modu" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="GameModeBox" Grid.Column="1" MinWidth="260">
                                <ComboBoxItem Content="Kapalı" />
                                <ComboBoxItem Content="Her zaman açık" />
                                <ComboBoxItem Content="Tam ekran algılanınca (önerilen)" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="GameModeStatus" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Oyun modunda ada tıklamaları alttaki oyuna geçirir ve fareyle genişlemez. Kontrolleri kullanmak için etkileşim modunu açın; 8 sn etkileşim olmazsa kendiliğinden kapanır. Masaüstü ve kenarlıksız tam ekranda çalışır; özel (exclusive) tam ekran oyunlarda normal pencereler görünmeyebilir — bunun için Xbox Game Bar pencere öğesine bakın (README)." />

                        <TextBlock Text="Kısayollar" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Genişlet / daralt" Style="{StaticResource RowLabel}" />
                            <local:HotkeyBox x:Name="ExpandHotkeyBox" Grid.Row="0" Grid.Column="1" Margin="0,3" />
                            <TextBlock x:Name="ExpandHotkeyStatus" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" />

                            <TextBlock Grid.Row="2" Text="Adayı göster / gizle" Style="{StaticResource RowLabel}" />
                            <local:HotkeyBox x:Name="VisibilityHotkeyBox" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                            <TextBlock x:Name="VisibilityHotkeyStatus" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Hint}" />

                            <TextBlock Grid.Row="4" Text="Etkileşim modu (tıklanabilir kontroller)" Style="{StaticResource RowLabel}" TextWrapping="Wrap" />
                            <local:HotkeyBox x:Name="InteractionHotkeyBox" Grid.Row="4" Grid.Column="1" Margin="0,3" />
                            <TextBlock x:Name="InteractionHotkeyStatus" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource Hint}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Değiştirmek için kutuya tıklayıp yeni kombinasyona basın. Backspace kısayolu kapatır, Esc vazgeçer. Ctrl+Alt kombinasyonları Türkçe klavyede AltGr karakterleriyle çakışabilir." />
                    </StackPanel>
                </Border>

                <!-- GÜNCELLEMELER -->
                <TextBlock Text="Güncellemeler" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="UpdatesBox" Content="Güncellemeleri otomatik denetle (açılışta ve günde bir)" Margin="0,4" />
                        <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,2" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <Button x:Name="CheckUpdateButton" Content="Şimdi denetle" />
                            <Button x:Name="InstallUpdateButton" Content="Güncelle" Margin="8,0,0,0" IsEnabled="False" />
                            <Button x:Name="ReleasesButton" Content="Sürüm sayfası" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Denetim için GitHub'a (api.github.com) uygulamanın adı ve sürümüyle istek gönderilir; başka bilgi gönderilmez. Güncelle'ye basınca yeni sürüm indirilir, GitHub'ın verdiği SHA-256 özetiyle doğrulanır, eskisinin yerine konur ve uygulama yeniden başlar." />
                    </StackPanel>
                </Border>

                <!-- HAKKINDA -->
                <TextBlock Text="Hakkında" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" />
                        <Button x:Name="OpenLogsButton" Content="Günlük klasörünü aç" HorizontalAlignment="Left" Margin="0,6,0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <Button x:Name="ExitButton" Content="Uygulamadan çık" DockPanel.Dock="Left" />
                <Button x:Name="CloseButton" Content="Kapat" DockPanel.Dock="Right" MinWidth="96" IsDefault="True" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
